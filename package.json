{
  "name": "ebay-ai-message",
  "version": "1.0.0",
  "private": true,
  "description": "eBay AI seller assistant — CLI + SaaS web",
  "main": "dist/index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "auth": "tsx src/auth.ts",
    "conversations": "tsx src/conversations.ts",
    "messages": "tsx src/messages.ts",
    "reply": "tsx src/reply.ts",
    "suggest": "tsx src/suggest.ts",
    "autoreply": "tsx src/autoreply.ts",
    "context": "tsx src/context.ts",
    "prompt": "tsx src/prompt-debug.ts",
    "sync": "tsx src/sync.ts",
    "rag": "tsx src/rag-cli.ts",
    "seller": "tsx src/seller-cli.ts",
    "seller:init": "tsx src/seller-cli.ts",
    "ai": "tsx src/ai-cli.ts",
    "inbox": "tsx src/inbox.ts",
    "web": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:start": "npm run start --workspace=web",
    "web:lint": "npm run lint --workspace=web",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.engine.json",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^17.4.2",
    "open": "^11.0.0",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
