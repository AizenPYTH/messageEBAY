# eBay credentials (sandbox | production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
# RuName must redirect to https://<app>/api/ebay/callback (and localhost in dev)
EBAY_RUNAME=
EBAY_ENV=production

# CLI / local fallback only — web uses encrypted user_connections
EBAY_USER_ACCESS_TOKEN=
EBAY_USER_REFRESH_TOKEN=

# AES key for encrypting per-user eBay tokens in DB (any long secret)
TOKEN_ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=

# Supabase (service role — serveur uniquement)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional default seller username for CLI (seller / seller:init)
EBAY_SELLER_USERNAME=

# --- Web app (apps/web) — public, safe for browser ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary: skip e-mail / Google login (open app + use EBAY_USER_ACCESS_TOKEN)
NEXT_PUBLIC_SKIP_AUTH=true
SKIP_AUTH=true
